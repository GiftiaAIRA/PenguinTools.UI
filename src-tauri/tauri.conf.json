{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenguinTools Extend",
  "version": "3.0.3",
  "identifier": "com.giftiaaira.penguintools.extend",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run stage:runtime && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PenguinTools Extend",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "resources/runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCREIzQzQ3MjdEMTQ0NjIKUldSaVJORW5SenpiMng0SStMN0dydlAzQ3BVcUV4eFFzd2FqNnVnZHk0QkRMTDZ1d1BtMkhDc3QK",
      "endpoints": [
        "https://github.com/GiftiaAIRA/PenguinTools.UI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
